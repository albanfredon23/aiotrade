# Copier en .env (jamais versionné, voir .gitignore) puis compléter si besoin.
# Toutes les valeurs ci-dessous sont des exemples : aucune clé réelle ici.

# --- Site (seul service exposé) ---
AIOTRADE_HTTP_PORT=80
AIOTRADE_HTTPS_PORT=443
# Dossier contenant fullchain.pem et privkey.pem (HTTPS actif s'ils existent)
AIOTRADE_CERTS_DIR=./certs

# --- Exécutant de trading (profil « trading », désactivé par défaut) ---
# paper : données publiques, exécution simulée, aucun ordre | binance : testnet ou live selon AIOTRADE_BINANCE_ENV
AIOTRADE_BROKER=paper
AIOTRADE_SYMBOL=BTCUSDT

# Testnet Binance Spot (https://testnet.binance.vision)
AIOTRADE_BINANCE_ENV=testnet
AIOTRADE_BINANCE_API_KEY=
AIOTRADE_BINANCE_API_SECRET=
# 0 = ordres validés sans exécution (/api/v3/order/test) ; 1 = ordres exécutés
AIOTRADE_SEND_ORDERS=0
# Plafond de notionnel par ordre (USDT)
AIOTRADE_MAX_ORDER_NOTIONAL=1000

# Live : à n'activer qu'après la check-list du README
# AIOTRADE_BINANCE_ENV=live
# AIOTRADE_LIVE_TRADING=JE_COMPRENDS_LES_RISQUES
# AIOTRADE_BINANCE_LIVE_API_KEY=
# AIOTRADE_BINANCE_LIVE_API_SECRET=
# AIOTRADE_MAX_ORDER_NOTIONAL=50
